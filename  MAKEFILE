NAME = playlist
CC = cc
CFLAGS = -Wall -Wextra -Werror

SRC = main.c ft_lstnew.c ft_lstsize.c ft_lstdelone.c ft_lstclear.c \
	ft_lstiter.c ft_lstadd_at.c ft_lstdel_at.c
OBJ = $(SRC:.c=.o)

all: $(NAME)

$(NAME): $(OBJ)
	$(CC) $(CFLAGS) $(OBJ) -o $(NAME)

%.o: %.c list.h morceau.h
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
